datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  buddy
  admin
  super_admin
}

enum BuddyStatus {
  pending
  trainee
  active
  rejected
  suspended
}

enum BuddyTier {
  junior
  buddy
  star
  blackstar
}

enum MemberType {
  buddy
  plab_member
}

enum GroupType {
  school
  company
  community
  other
}

enum TourStatus {
  draft
  published
  cancelled
  completed
}

enum BookingStatus {
  confirmed
  maybe
  waitlist
  declined
}

enum CancellationCategory {
  health
  emergency
  personal
  work
  other
}

// Every event a person can configure email for, across both audiences.
// packages/types splits it back into the admin set (NotifEventTypeSchema) and
// the buddy set (BuddyNotifEventTypeSchema) — the two screens are different.
//
// Buddy events a buddy MUST NOT be able to mute are deliberately absent:
// tour_cancelled, waitlist_promoted, account_approved, account_rejected. A row
// for them cannot be stored, so the opt-out is unreachable rather than merely
// hidden (docs/decisions.md 2026-09-18).
enum NotifEventType {
  new_signup
  new_booking
  cancellation
  maybe_resolved
  maybe_deadline_missed
  tour_published
  tour_details_changed
  tour_reminder
  maybe_reminder
}

enum EmailMode {
  immediate
  digest
}

enum BookingPool {
  junior
  non_junior
  anyone
}

enum Locale {
  ja
  en
}

enum NotificationChannel {
  in_app
  email
  slack
}

enum NotificationJobStatus {
  pending
  sent
  failed
  dead
}

model User {
  id                          String                              @id @default(uuid())
  firebaseUid                 String                              @unique
  email                       String
  role                        UserRole
  locale                      Locale                              @default(ja)
  createdAt                   DateTime                            @default(now())
  buddyProfile                BuddyProfile?
  adminProfile                AdminProfile?
  adminEvaluationsCreated     AdminEvaluation[]                   @relation("AdminEvalCreator")
  profileEvaluationsCreated   AdminProfileEvaluation[]            @relation("ProfileEvalCreator")
  notificationPrefs           NotificationPreference[]
  notifications               Notification[]
  notificationJobs            NotificationJob[]
  digestQueue                 DigestQueue[]
  cancellationReasonsRecorded CancellationReason[]
  deadlineOverridesSet        BuddyCancellationDeadlineOverride[]
}

model BuddyProfile {
  id               String                              @id @default(uuid())
  userId           String                              @unique
  status           BuddyStatus
  tier             BuddyTier?
  memberType       MemberType                          @default(buddy)
  displayName      String
  realName         String
  photoKey         String?
  bio              String?
  contactInfo      String?
  languages        String[]
  skills           String[]
  internalNotes    String?
  onboardingSeenAt DateTime?
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  user             User                                @relation(fields: [userId], references: [id])
  bookings         Booking[]
  reflections        TourReflection[]
  adminEvaluations   AdminEvaluation[]
  profileEvaluations AdminProfileEvaluation[]
  deadlineOverrides BuddyCancellationDeadlineOverride[]
}

model AdminProfile {
  id               String                @id @default(uuid())
  userId           String                @unique
  name             String
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  user             User                  @relation(fields: [userId], references: [id])
  tourAssignments  TourAdminAssignment[]
  toursInCharge    Tour[]                @relation("StaffInCharge")

  @@index([deletedAt])
}

model Group {
  id           String    @id @default(uuid())
  name         String
  type         GroupType
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tours        Tour[]
}

model Tour {
  id                   String                              @id @default(uuid())
  groupId              String
  status               TourStatus
  tourDate             DateTime                            @db.Date
  bookingOpen          Boolean                             @default(false)
  description          String?
  adminMemo            String?
  cancellationDeadline DateTime                            @db.Date
  maybeDeadline        DateTime?                           @db.Date
  notificationOffsets  Int[]
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  staffInChargeId      String?
  group                Group                               @relation(fields: [groupId], references: [id])
  staffInCharge        AdminProfile?                       @relation("StaffInCharge", fields: [staffInChargeId], references: [id])
  sessions             TourSession[]
  bookings             Booking[]
  adminEvaluations     AdminEvaluation[]
  deadlineOverrides    BuddyCancellationDeadlineOverride[]
  adminAssignments     TourAdminAssignment[]

  @@index([status, tourDate])
}

// Admin-managed lookup table for tour locations. Retired via `active = false`,
// never deleted — TourSessions and TourReflectionMoments reference rows by id
// (docs/decisions.md 2026-09-23, "Places and spots replace free-text
// location").
model Place {
  id        String      @id @default(uuid())
  nameJa    String
  nameEn    String
  sortOrder Int
  active    Boolean     @default(true)
  spots     Spot[]
  sessions  TourSession[]
}

// A point of interest inside a Place (e.g. a monument inside a park). Not
// every Place has spots — a buddy reflecting on a tour whose places have none
// gets a single free-text moment instead of a spot picker (see TourReflectionMoment).
model Spot {
  id        String                 @id @default(uuid())
  placeId   String
  nameJa    String
  nameEn    String
  sortOrder Int
  active    Boolean                @default(true)
  place     Place                  @relation(fields: [placeId], references: [id])
  moments   TourReflectionMoment[]

  @@index([placeId])
}

model TourAdminAssignment {
  id        String       @id @default(uuid())
  tourId    String
  adminId   String
  createdAt DateTime     @default(now())
  tour      Tour         @relation(fields: [tourId], references: [id], onDelete: Cascade)
  admin     AdminProfile @relation(fields: [adminId], references: [id])

  @@unique([tourId, adminId])
}

model TourSession {
  id               String        @id @default(uuid())
  tourId           String
  order            Int
  label            String?
  meetingTime      DateTime      @db.Time
  startTime        DateTime?     @db.Time
  endTime          DateTime?     @db.Time
  capacity         Int
  minBuddies       Int?
  participantCount Int           @default(0)
  // Exactly one place per session; sessions of one tour may go to different
  // places. Changing it is locked while a moment on this session references
  // a spot of the old place (rule enforced in adminSession.service.ts).
  placeId          String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tour             Tour          @relation(fields: [tourId], references: [id])
  place            Place         @relation(fields: [placeId], references: [id])
  bookings         Booking[]
  tierCapacities   TierCapacity[]
  reflections      TourReflection[]

  @@unique([tourId, order])
  @@index([tourId])
  @@index([placeId])
}

model TierCapacity {
  id        String      @id @default(uuid())
  sessionId String
  pool      BookingPool
  percent   Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  session   TourSession     @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, pool])
}

model Booking {
  id                 String               @id @default(uuid())
  buddyId            String
  tourId             String
  sessionId          String
  buddyTier          BuddyTier
  status             BookingStatus
  bookedAt           DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  buddy              BuddyProfile         @relation(fields: [buddyId], references: [id])
  tour               Tour                 @relation(fields: [tourId], references: [id])
  session            TourSession          @relation(fields: [sessionId], references: [id])
  cancellationReason CancellationReason?

  @@unique([buddyId, sessionId])
  @@index([tourId, status])
  @@index([sessionId, status])
  @@index([sessionId, status, buddyTier])
}

model CancellationReason {
  id          String               @id @default(uuid())
  bookingId   String               @unique
  category    CancellationCategory
  freeText    String?
  unavoidable Boolean?
  recordedBy  String
  createdAt   DateTime             @default(now())
  booking     Booking              @relation(fields: [bookingId], references: [id])
  recorder    User                 @relation(fields: [recordedBy], references: [id])
}

model AdminEvaluation {
  id                  String       @id @default(uuid())
  buddyId             String
  tourId              String
  createdBy           String
  overallRating       Int?
  overallRatingNote   String?
  reliability         Int?
  reliabilityNote     String?
  communication       Int?
  communicationNote   String?
  groupEngagement     Int?
  groupEngagementNote String?
  memory              Int?
  memoryNote          String?
  knowledge           Int?
  knowledgeNote       String?
  dedication          Int?
  dedicationNote      String?
  dialogue            Int?
  dialogueNote        String?
  adaptability        Int?
  adaptabilityNote    String?
  emotionNote         String?
  confidence          Int?
  confidenceNote      String?
  absentWithoutReport Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  buddy               BuddyProfile @relation(fields: [buddyId], references: [id])
  tour                Tour         @relation(fields: [tourId], references: [id])
  creator             User         @relation("AdminEvalCreator", fields: [createdBy], references: [id])

  @@unique([buddyId, tourId, createdBy])
}

model AdminProfileEvaluation {
  id                  String       @id @default(uuid())
  buddyId             String
  createdBy           String
  overallRating       Int?
  overallRatingNote   String?
  reliability         Int?
  reliabilityNote     String?
  communication       Int?
  communicationNote   String?
  groupEngagement     Int?
  groupEngagementNote String?
  memory              Int?
  memoryNote          String?
  knowledge           Int?
  knowledgeNote       String?
  dedication          Int?
  dedicationNote      String?
  dialogue            Int?
  dialogueNote        String?
  adaptability        Int?
  adaptabilityNote    String?
  emotionNote         String?
  confidence          Int?
  confidenceNote      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  buddy               BuddyProfile @relation(fields: [buddyId], references: [id])
  creator             User         @relation("ProfileEvalCreator", fields: [createdBy], references: [id])

  @@unique([buddyId, createdBy])
}

// A buddy's own account of a session they guided: five free-text prompts, no
// scores. Keyed on the session, but the obligation is per tour — one reflection
// anywhere in a tour silences the prompt (docs/decisions.md 2026-09-23).
model TourReflection {
  id              String                 @id @default(uuid())
  buddyId         String
  sessionId       String
  didWell         String?
  couldImprove    String?
  notesForOthers  String?
  openQuestions   String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  buddy           BuddyProfile           @relation(fields: [buddyId], references: [id])
  session         TourSession            @relation(fields: [sessionId], references: [id])
  moments         TourReflectionMoment[]

  @@unique([buddyId, sessionId])
  @@index([sessionId])
}

// A structured memorable moment (docs/decisions.md — "Places and spots
// replace free-text location"), replacing the old `memorableMoment` free-text
// column. `position` keeps the buddy's entry order — row order is not
// guaranteed, so this is read back sorted by it, never by createdAt (identical
// within one createMany) or id (random UUIDs).
// Exactly one of spotId/placeNote is set — enforced in Zod, not the DB.
model TourReflectionMoment {
  id           String         @id @default(uuid())
  reflectionId String
  position     Int
  spotId       String?
  placeNote    String?
  description  String
  reflection   TourReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  spot         Spot?          @relation(fields: [spotId], references: [id])

  @@index([reflectionId])
  @@index([spotId])
}

model BuddyCancellationDeadlineOverride {
  id        String       @id @default(uuid())
  buddyId   String
  tourId    String
  deadline  DateTime     @db.Date
  setBy     String
  createdAt DateTime     @default(now())
  buddy     BuddyProfile @relation(fields: [buddyId], references: [id])
  tour      Tour         @relation(fields: [tourId], references: [id])
  setter    User         @relation(fields: [setBy], references: [id])

  @@unique([buddyId, tourId])
}

// Per-user, per-event email configuration, for admins and buddies alike.
// `emailMode` and `slackEnabled` are admin-only concepts: buddy rows carry
// `immediate` / `false` and nothing reads them for a buddy.
model NotificationPreference {
  id           String         @id @default(uuid())
  userId       String
  eventType    NotifEventType
  emailEnabled Boolean
  emailMode    EmailMode
  slackEnabled Boolean
  user         User           @relation(fields: [userId], references: [id])

  @@unique([userId, eventType])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model DigestQueue {
  id        String    @id @default(uuid())
  adminId   String
  eventType String
  payload   Json
  flushedAt DateTime?
  createdAt DateTime  @default(now())
  admin     User      @relation(fields: [adminId], references: [id])

  @@index([adminId, flushedAt])
}

model NotificationJob {
  id              String                @id @default(uuid())
  channel         NotificationChannel
  eventType       String
  recipientUserId String?
  payload         Json
  locale          Locale                @default(ja)
  status          NotificationJobStatus @default(pending)
  attempts        Int                   @default(0)
  scheduledFor    DateTime              @default(now())
  sentAt          DateTime?
  lastError       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  recipient       User?                 @relation(fields: [recipientUserId], references: [id])

  @@index([status, scheduledFor])
  @@index([recipientUserId])
}

// Idempotency log for scheduled notification jobs (PRD §10.5). Each scheduled
// job inserts a row keyed by `{eventType}:{scope}:{recipientUserId}` inside the
// same transaction that enqueues the NotificationJob. A unique-constraint
// collision means the reminder was already dispatched for that recipient — the
// transaction rolls back and no duplicate job is enqueued.
model NotificationDispatchLog {
  id        String   @id @default(uuid())
  eventKey  String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}
