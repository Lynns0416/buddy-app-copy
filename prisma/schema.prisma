datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  buddy
  admin
  super_admin
}

enum BuddyStatus {
  pending
  trainee
  active
  rejected
  suspended
}

enum BuddyTier {
  junior
  mid
  senior
  expert
  instructor
  organizer
}

enum GroupType {
  school
  company
  community
  other
}

enum TourStatus {
  draft
  published
  cancelled
  completed
}

enum BookingStatus {
  confirmed
  maybe
  waitlist
  declined
}

enum CancellationCategory {
  health
  emergency
  personal
  work
  other
}

enum NotifEventType {
  new_signup
  new_booking
  cancellation
  maybe_resolved
  maybe_deadline_missed
}

enum EmailMode {
  immediate
  digest
}

model User {
  id                          String                              @id @default(uuid())
  firebaseUid                 String                              @unique
  email                       String
  role                        UserRole
  createdAt                   DateTime                            @default(now())
  buddyProfile                BuddyProfile?
  evaluationsGiven            AdminEvaluation[]                   @relation("Evaluator")
  notificationPrefs           NotificationPreference[]
  notifications               Notification[]
  digestQueue                 DigestQueue[]
  cancellationReasonsRecorded CancellationReason[]
  deadlineOverridesSet        BuddyCancellationDeadlineOverride[]
}

model BuddyProfile {
  id               String                              @id @default(uuid())
  userId           String                              @unique
  status           BuddyStatus
  tier             BuddyTier?
  displayName      String
  realName         String
  photoUrl         String?
  bio              String?
  contactInfo      String?
  languages        String[]
  skills           String[]
  availability     String?
  internalNotes    String?
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  user             User                                @relation(fields: [userId], references: [id])
  bookings         Booking[]
  selfEvaluations  SelfEvaluation[]
  adminEvaluations AdminEvaluation[]
  deadlineOverrides BuddyCancellationDeadlineOverride[]
}

model Group {
  id           String    @id @default(uuid())
  name         String
  type         GroupType
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tours        Tour[]
}

model Tour {
  id                   String                              @id @default(uuid())
  groupId              String
  status               TourStatus
  tourDate             DateTime                            @db.Date
  meetingTime          DateTime                            @db.Time
  location             String
  capacity             Int
  description          String?
  adminMemo            String?
  cancellationDeadline DateTime                            @db.Date
  maybeDeadline        DateTime?                           @db.Date
  notificationOffsets  Int[]
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  group                Group                               @relation(fields: [groupId], references: [id])
  bookings             Booking[]
  adminEvaluations     AdminEvaluation[]
  selfEvaluations      SelfEvaluation[]
  deadlineOverrides    BuddyCancellationDeadlineOverride[]

  @@index([status, tourDate])
}

model Booking {
  id                 String              @id @default(uuid())
  buddyId            String
  tourId             String
  status             BookingStatus
  bookedAt           DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  buddy              BuddyProfile        @relation(fields: [buddyId], references: [id])
  tour               Tour                @relation(fields: [tourId], references: [id])
  cancellationReason CancellationReason?

  @@unique([buddyId, tourId])
  @@index([tourId, status])
  @@index([tourId, status, updatedAt])
}

model CancellationReason {
  id          String               @id @default(uuid())
  bookingId   String               @unique
  category    CancellationCategory
  freeText    String?
  unavoidable Boolean
  recordedBy  String
  createdAt   DateTime             @default(now())
  booking     Booking              @relation(fields: [bookingId], references: [id])
  recorder    User                 @relation(fields: [recordedBy], references: [id])
}

model AdminEvaluation {
  id                  String       @id @default(uuid())
  buddyId             String
  tourId              String?
  evaluatorId         String
  overallRating       Int?
  overallRatingNote   String?
  reliability         Int?
  reliabilityNote     String?
  communication       Int?
  communicationNote   String?
  groupEngagement     Int?
  groupEngagementNote String?
  memory              Int?
  memoryNote          String?
  knowledge           Int?
  knowledgeNote       String?
  dedication          Int?
  dedicationNote      String?
  dialogue            Int?
  dialogueNote        String?
  adaptability        Int?
  adaptabilityNote    String?
  emotionNote         String?
  confidence          Int?
  confidenceNote      String?
  createdAt           DateTime     @default(now())
  buddy               BuddyProfile @relation(fields: [buddyId], references: [id])
  tour                Tour?        @relation(fields: [tourId], references: [id])
  evaluator           User         @relation("Evaluator", fields: [evaluatorId], references: [id])
}

model SelfEvaluation {
  id                  String       @id @default(uuid())
  buddyId             String
  tourId              String
  overallRating       Int?
  overallRatingNote   String?
  communication       Int?
  communicationNote   String?
  groupEngagement     Int?
  groupEngagementNote String?
  memory              Int?
  memoryNote          String?
  knowledge           Int?
  knowledgeNote       String?
  dedication          Int?
  dedicationNote      String?
  dialogue            Int?
  dialogueNote        String?
  adaptability        Int?
  adaptabilityNote    String?
  emotionNote         String?
  confidence          Int?
  confidenceNote      String?
  createdAt           DateTime     @default(now())
  buddy               BuddyProfile @relation(fields: [buddyId], references: [id])
  tour                Tour         @relation(fields: [tourId], references: [id])

  @@unique([buddyId, tourId])
}

model BuddyCancellationDeadlineOverride {
  id        String       @id @default(uuid())
  buddyId   String
  tourId    String
  deadline  DateTime     @db.Date
  setBy     String
  createdAt DateTime     @default(now())
  buddy     BuddyProfile @relation(fields: [buddyId], references: [id])
  tour      Tour         @relation(fields: [tourId], references: [id])
  setter    User         @relation(fields: [setBy], references: [id])

  @@unique([buddyId, tourId])
}

model NotificationPreference {
  id           String         @id @default(uuid())
  adminId      String
  eventType    NotifEventType
  emailEnabled Boolean
  emailMode    EmailMode
  slackEnabled Boolean
  admin        User           @relation(fields: [adminId], references: [id])

  @@unique([adminId, eventType])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model DigestQueue {
  id        String    @id @default(uuid())
  adminId   String
  eventType String
  payload   Json
  flushedAt DateTime?
  createdAt DateTime  @default(now())
  admin     User      @relation(fields: [adminId], references: [id])

  @@index([adminId, flushedAt])
}
