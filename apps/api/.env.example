# CORS — set to your web origin in staging/prod
CORS_ORIGIN="http://localhost:3000"

# Firebase
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-service-account-email"
FIREBASE_PRIVATE_KEY="your-service-account-private-key"

# Use Firebase Auth emulator in local dev
FIREBASE_AUTH_EMULATOR_HOST="host.docker.internal:9099"

# Scheduled jobs — any string in local dev
SCHEDULER_SECRET="local-secret"

# Email — Gmail API via service account + domain-wide delegation.
# Reuses FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY above as the service
# account credentials. In Workspace admin console, grant that service account
# scope `https://www.googleapis.com/auth/gmail.send` and the ability to
# impersonate GMAIL_SENDER. Then set GMAIL_SENDER to the impersonated mailbox.
GMAIL_SENDER=""
# Set to "true" in dev/test to log emails instead of sending.
EMAIL_DISABLED="true"
# Used to build links inside email and Slack message bodies (no trailing slash).
WEB_BASE_URL="http://localhost:3000"

# Slack — primary channel for admin notifications (docs/decisions.md 2026-08-15).
# Create a Slack app, enable Incoming Webhooks, install it to the workspace, and
# paste the generated URL here. Posts go to one shared channel; there is no
# per-admin targeting.
SLACK_WEBHOOK_URL=""
# Posting is off outside production unless SLACK_ENABLED="true". Set it to
# exercise real delivery in dev; leave unset to log instead of posting.
SLACK_ENABLED=""
# Kill switch — "true" forces a no-op even in production.
SLACK_DISABLED=""

# Photo storage — docker-compose.yml sets STORAGE_* to point at Azurite.
# Do not add them here.
