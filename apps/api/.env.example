# CORS — set to your web origin in staging/prod
CORS_ORIGIN="http://localhost:3000"

# Firebase
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-service-account-email"
FIREBASE_PRIVATE_KEY="your-service-account-private-key"

# Use Firebase Auth emulator in local dev
FIREBASE_AUTH_EMULATOR_HOST="host.docker.internal:9099"

# Scheduled jobs — any string in local dev
SCHEDULER_SECRET="local-secret"

# Email (leave blank to skip in dev)
RESEND_API_KEY=""

# Slack (leave blank to skip in dev)
SLACK_WEBHOOK_URL=""

# Cloudflare R2 (photo uploads — leave blank to skip in dev)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""  # e.g. https://staging-buddy-photos.plab.jp or https://pub-xxxx.r2.dev
