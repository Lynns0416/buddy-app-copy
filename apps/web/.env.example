# Firebase client config (from Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"

# Use Firebase Auth emulator in local dev
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"

# Apple sign-in. Off unless exactly "true" — the Firebase Apple provider
# (Service ID + key) is not configured yet, so the button shows "coming soon".
# NEXT_PUBLIC_* is inlined at build time, so flipping this needs a rebuild.
NEXT_PUBLIC_APPLE_SIGN_IN_ENABLED="false"
