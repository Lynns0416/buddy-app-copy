# Copy to scripts/deploy.env (prod) or scripts/deploy.stg.env (staging), fill
# in, pass the path to scripts/deploy.sh. `deploy*.env` is gitignored; the
# script refuses to read a file anyone but the owner can:
#   cp scripts/deploy.env.example scripts/deploy.stg.env
#   chmod 600 scripts/deploy.stg.env
#
# Quote every value — the connection strings contain & and ? and the PEM
# contains spaces, and this file is sourced by the shell.
#
# Infrastructure names below must match the scripts/azure*.env used to
# provision the environment. That file creates the resources; this one only
# names them and carries the application secrets.

# --- Which environment this deploys ------------------------------------
# Printed in the confirmation banner before anything is built. Red for prod,
# blue for anything else, matching scripts/azure-provision.sh.
ENVIRONMENT='staging'

# --- Azure resources ---------------------------------------------------
# Prod and staging share all four of these. Only the app names differ.
RESOURCE_GROUP='rg-peace-buddy'
ACR_NAME='crpeacebuddy'
ACA_ENV='cae-peace-buddy'
# ca-api / ca-web for prod, ca-api-stg / ca-web-stg for staging.
# See docs/decisions.md 2026-09-12, "Four apps in one Container Apps
# environment".
ACA_API='ca-api-stg'
ACA_WEB='ca-web-stg'

# --- Database ----------------------------------------------------------
# Both strings are printed by scripts/azure-db-roles.sh, which creates the
# roles. Never the server admin account, and never the same role twice — the
# script refuses that. See docs/deploy-plan.md §4.1.
#
# The host is whatever `az postgres flexible-server show --query
# fullyQualifiedDomainName` returns, which resolves only inside the VNet.
# Do not build it from the server name and the private zone name.
#
# pb_app — reads and writes rows, cannot create, alter or drop anything.
# This is what the deployed api connects as.
#   postgresql://pb_app:<PG_APP_PASSWORD>@<fqdn>:5432/peacebuddy?sslmode=require
DATABASE_URL=

# pb_migrate — owns the tables. Used by the one-shot migration job that
# scripts/deploy.sh runs before the api is updated, and by nothing else. The
# job is deleted after every run, so this password never sits in a long-lived
# container. See docs/decisions.md, "migrate deploy runs as a one-shot
# Container Apps Job".
#   postgresql://pb_migrate:<PG_MIGRATE_PASSWORD>@<fqdn>:5432/peacebuddy?sslmode=require
MIGRATE_DATABASE_URL=

# Firebase service account (console -> Project settings -> Service accounts)
FIREBASE_PROJECT_ID='peace-buddy-staging'
FIREBASE_CLIENT_EMAIL=
# One line, with \n for the newlines, exactly as in the service account JSON
FIREBASE_PRIVATE_KEY=

# Firebase web app config — public by design, but inlined at build time
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Any random string: openssl rand -hex 24
SCHEDULER_SECRET=

# Set to 'true' to log emails instead of sending. Blank turns sending on.
EMAIL_DISABLED='true'
# From: address. May be an alias of GMAIL_IMPERSONATE.
GMAIL_SENDER=
# Mailbox domain-wide delegation impersonates. Set only when the From: address
# should differ from it. Defaults to GMAIL_SENDER when blank.
GMAIL_IMPERSONATE=
# Slack incoming webhook. Posting is on whenever this is set in production.
SLACK_WEBHOOK_URL=
SLACK_ENABLED=

# Cloudflare R2 — required. Buddy photo upload 500s without them.
# R2_PUBLIC_URL is the bucket's public r2.dev URL, no trailing slash. Use a
# custom domain only once it is bound in Cloudflare and serving its own cert.
# These leave the stack when photos move to Azure Blob; see docs/deploy-plan.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
