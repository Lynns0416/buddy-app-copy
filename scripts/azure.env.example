# Azure provisioning config. Copy to scripts/azure.env and fill in.
#   cp scripts/azure.env.example scripts/azure.env
#   chmod 600 scripts/azure.env
# scripts/azure.env is gitignored. Never commit a filled-in copy. The script
# refuses to run unless the file is owner-only, because it holds the password.
#
# Used by scripts/azure-provision.sh, which creates infrastructure.
# Application deploys are a separate concern — see scripts/deploy.sh.

# --- Which environment this file provisions -----------------------------
# Printed in the confirmation prompt before anything is created. prod and
# staging share every resource below except the database server, so this is
# the only thing distinguishing one run from the other on screen.
ENVIRONMENT=prod

# --- Naming and region -------------------------------------------------
# Prefixes follow Azure's Cloud Adoption Framework abbreviations.
RESOURCE_GROUP=rg-peace-buddy
LOCATION=japaneast

# Container registry. Globally unique across all of Azure, alphanumeric only.
ACR_NAME=crpeacebuddy

# Container Apps environment. Created by this script.
ACA_ENV=cae-peace-buddy
# User-assigned identity that both apps and the migration job use to pull
# images. Created by this script and granted AcrPull on the registry, once,
# so that nothing ever waits on a seconds-old role assignment. The same name
# goes in the deploy config. See docs/decisions.md 2026-09-13.
ACR_PULL_IDENTITY=id-peace-buddy-acrpull
# Names of the two apps. Not read by this script — the deploy script creates and
# updates them. Kept here so both scripts agree on the names.
ACA_API=ca-api
ACA_WEB=ca-web

# --- Network -----------------------------------------------------------
# The database has no public endpoint. It is reachable only from inside
# this VNet, so the apps and the database each get their own subnet.
VNET_NAME=vnet-peace-buddy
VNET_CIDR=10.0.0.0/16
# The environment is created with workload profiles, which needs /27 or larger,
# and which requires this subnet be delegated to Microsoft.App/environments.
# /23 is deliberately roomier: subnet size is fixed once the environment exists.
SUBNET_APPS=snet-apps
SUBNET_APPS_CIDR=10.0.0.0/23
# Delegated to Microsoft.DBforPostgreSQL/flexibleServers.
SUBNET_DB=snet-db
SUBNET_DB_CIDR=10.0.4.0/24
# Private DNS zone that resolves the server's hostname inside the VNet.
DNS_ZONE=peace-buddy.private.postgres.database.azure.com

# --- Database ----------------------------------------------------------
# Match docker-compose.yml, which runs postgres:16.
PG_SERVER=psql-peace-buddy
PG_VERSION=16
PG_TIER=Burstable
PG_SKU=Standard_B1ms
PG_STORAGE_GB=32
PG_DB_NAME=peacebuddy
PG_ADMIN_USER=pbadmin

# Generate with: openssl rand -base64 24
# Store it in a password manager. Leave blank here in the .example file.
PG_ADMIN_PASSWORD=

# --- Application roles -------------------------------------------------
# Created by scripts/azure-db-roles.sh, which is run once per server right
# after provisioning. The admin account above can administer every database on
# the server, so it must never reach DATABASE_URL. These two replace it.
#
#   PG_MIGRATE_USER  owns the tables. Runs `prisma migrate deploy` and nothing
#                    else. Keep its password out of any running container.
#   PG_APP_USER      reads and writes rows, cannot CREATE, ALTER or DROP. This
#                    is the one that goes in DATABASE_URL in deploy.env.
#
# Same names on both servers is fine — the servers are separate. Re-running
# the script resets both passwords to whatever is here, which is how a
# rotation is done.
#
# Generate each with: openssl rand -base64 24
# The script rejects a value containing a quote, backslash, backtick or dollar
# sign, because it is interpolated into both psql and YAML. base64 never
# produces one.
PG_MIGRATE_USER=pb_migrate
PG_MIGRATE_PASSWORD=
PG_APP_USER=pb_app
PG_APP_PASSWORD=

# --- Cost alerts -------------------------------------------------------
# Read by scripts/azure-cost-alerts.sh. Amounts are in yen because Cost
# Management bills this subscription in JPY; Azure's own rate is ~¥159.3 to
# the dollar (Retail Prices API, 2026-09-13). See docs/azure-costs.md.
COST_ALERT_EMAIL=
# Whole subscription, per year. ¥160,000 is ~$1,000, half the $2,000 grant.
BUDGET_ANNUAL_JPY=160000
# This file's Postgres server alone, per month. Ignored for prod. ¥1,600 is
# ~$10: staging's storage is ~¥700 of that whether it runs or not, and a month
# left running adds ~¥3,000 of compute.
BUDGET_SERVER_MONTHLY_JPY=1600
